# Python Virtual Environment (Môi trường ảo)
venv/
env/
ENV/
.venv/

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Tệp trọng số mô hình kích thước lớn (Model Weights & Indexes)
# Ngăn push file nặng >100MB lên Git
weights/*.pth
weights/*.index
*.pth
*.index

# Audio Outputs & Temp Files (Dữ liệu tạm và kết quả xuất ra)
outputs/*.wav
outputs/*.mp3
outputs/*.flac
data/samples/*
!data/samples/.gitkeep

# IDE & Editor Configs (Cấu hình riêng của máy cá nhân)
.vscode/
.idea/
*.swp
*.swo

# OS System Files
.DS_Store
Thumbs.db